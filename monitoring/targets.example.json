{
  "interval_seconds": 60,
  "failure_threshold": 3,
  "recovery_threshold": 2,
  "max_concurrency": 4,
  "allowed_networks": [
    "192.168.30.10/32",
    "192.168.0.100/32",
    "192.168.0.127/32"
  ],
  "targets": [
    {
      "name": "realhd-switch",
      "host": "192.168.30.10",
      "tcp_port": 80,
      "snmp": {
        "version": "3",
        "user": "bgadmin",
        "security_level": "authPriv",
        "auth_protocol": "SHA",
        "priv_protocol": "DES",
        "allow_legacy_des": true,
        "auth_env": "KSSH_REALHD_AUTH_PASS",
        "priv_env": "KSSH_REALHD_PRIV_PASS",
        "adapter": "realhd",
        "port": 161,
        "timeout": 2.0,
        "retries": 1
      }
    },
    {
      "name": "pve1",
      "host": "192.168.0.100",
      "tcp_port": 8006
    },
    {
      "name": "pve2",
      "host": "192.168.0.127",
      "tcp_port": 8006
    }
  ]
}
